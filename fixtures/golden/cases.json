    {"name": "load_world_all_entities", "script": "load_world", "args": ["--world", "worlds/Harrowmere", "--all-entities"]},

    {"name": "load_bible_minimal", "script": "load_bible", "args": ["--story", "stories/Salt and Signal", "--world", "worlds/Harrowmere", "--no-style", "--no-last-chapter", "--no-timeline"]},
    {"name": "load_bible_writer", "script": "load_bible", "args": ["--story", "stories/Salt and Signal", "--world", "worlds/Harrowmere", "--position", "1", "--style", "Default Style", "--char", "Mara Quill", "--char", "Tamsin O'Rook", "--loc", "The Tally House", "--faction", "Harbor Guild"]},
    {"name": "load_bible_planner", "script": "load_bible", "args": ["--story", "stories/Salt and Signal", "--world", "worlds/Harrowmere", "--structure", "Freytag's Pyramid", "--no-style", "--description", "--hooks", "--position", "1", "--faction", "Tidewright Union", "--faction", "Fen Wardens"]},
    {"name": "load_bible_no_schemes_no_facts", "script": "load_bible", "args": ["--story", "stories/Salt and Signal", "--world", "worlds/Harrowmere", "--no-style", "--no-last-chapter", "--no-schemes", "--no-facts", "--myth", "The Tithe Ledger Clause"]},
    {"name": "load_bible_story1", "script": "load_bible", "args": ["--story", "stories/The Tallow Ledger", "--world", "worlds/Harrowmere", "--no-style", "--char", "Mara Quill"]},

    {"name": "create_snapshot_position3", "script": "create_snapshot", "mutating": true, "args": ["--world", "worlds/Harrowmere", "--position", "3", "--story", "Golden Test Story", "--unit", "Full Story"], "digest": ["worlds/Harrowmere/snapshots"]}
  ]
