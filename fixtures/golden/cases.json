    {"name": "query_position_missing_story", "script": "query_position", "args": ["--world", "worlds/Harrowmere", "--story", "No Such Story", "--format", "json"], "allow_nonzero": true},

    {"name": "load_world_overview", "script": "load_world", "args": ["--world", "worlds/Harrowmere"]},
